    "check": "pnpm run lint && pnpm run format:check",
    "lint": "tsc --noEmit && node scripts/check-architecture.mjs",
    "test": "tsx --test tests/*.test.ts",
    "start": "node scripts/start.mjs --production",
    "test:integration": "node scripts/test-integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:voice": "tsx scripts/voice-eval.ts",
    "eval:capability": "tsx evals/src/cli.ts"
